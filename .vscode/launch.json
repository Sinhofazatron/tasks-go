  "version": "0.2.0",
  "configurations": [
    {
      "name": "Launch Package",
      "type": "go",
      "request": "launch",
      "mode": "auto",
      "program": "${workspaceFolder}/cmd/todoapp/main.go",
      "env": {
        "HTTP_ADDR": ":5050",
        "HTTP_SHUTDOWN_TIMEOUT": "30s",

        "LOGGER_LEVEL": "DEBUG",
        "LOGGER_FOLDER": "${workspaceFolder}/out/logs",

        "POSTGRES_USER": "test-user-123",
        "POSTGRES_HOST": "localhost",
        "POSTGRES_PORT": "5432",
        "POSTGRES_PASSWORD": "test-postgres-password-456",
        "POSTGRES_DB": "test-db",
        "POSTGRES_TIMEOUT": "10s"
      }
    }
  ]
}
